# Server
PORT=5000
NODE_ENV=development

# CORS (production only — comma-separated list of allowed origins)
# ⚠️ WAJIB diisi di production. Jika kosong di production, SEMUA request
#    cross-origin akan DITOLAK (bukan diizinkan semua).
# Example: CORS_ORIGIN=https://pa-cimahi.go.id,https://www.pa-cimahi.go.id
CORS_ORIGIN=

# Trust Proxy
# Isi 'true' HANYA jika backend berjalan di belakang reverse proxy
# (nginx/Apache/load balancer). Kalau backend menerima trafik publik
# langsung, biarkan kosong/false (default aman).
TRUST_PROXY=false

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=pa_cimahi_db

# JWT
# ⚠️ IMPORTANT: Generate a strong random secret! Never use the default in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=24h
